# AION Surreal Boost Vulkan layer (v1.1)
CXX      ?= g++
CXXFLAGS ?= -std=c++17 -O2 -Wall -Wextra -Wno-missing-field-initializers -fPIC -fvisibility=hidden
LIB      := libVkLayer_surreal_boost.so
PREFIX   ?= /usr
LIBDIR   := $(PREFIX)/lib/surreal-boost
LAYERDIR := $(PREFIX)/share/vulkan/implicit_layer.d
BINDIR   := $(PREFIX)/bin

all: $(LIB)

$(LIB): surreal_vk_layer.cpp upscale_shaders_spv.h
	# libstdc++/libgcc linked statically so the layer also loads inside the older Steam Linux Runtime
	# (pressure-vessel "sniper") container, which ships an older libstdc++ than the host.
	$(CXX) $(CXXFLAGS) -shared -static-libstdc++ -static-libgcc -o $@ surreal_vk_layer.cpp -lpthread

shaders: shaders/upscale.vert shaders/upscale_cas.frag
	glslangValidator -V --vn kUpscaleVertSpv shaders/upscale.vert -o /tmp/surreal_vert_spv.h >/dev/null
	glslangValidator -V --vn kUpscaleFragSpv shaders/upscale_cas.frag -o /tmp/surreal_frag_spv.h >/dev/null
	{ echo "// Auto-generated by glslangValidator from shaders/upscale.vert and shaders/upscale_cas.frag"; \
	  echo "#pragma once"; \
	  echo "#include <cstdint>"; \
	  grep -v '#pragma' /tmp/surreal_vert_spv.h; \
	  echo ""; \
	  grep -v '#pragma' /tmp/surreal_frag_spv.h; \
	} > upscale_shaders_spv.h
	rm -f /tmp/surreal_vert_spv.h /tmp/surreal_frag_spv.h

install: $(LIB)
	install -d $(DESTDIR)$(LIBDIR) $(DESTDIR)$(LAYERDIR) $(DESTDIR)$(BINDIR) $(DESTDIR)/etc/surreal-boost
	install -m 755 $(LIB) $(DESTDIR)$(LIBDIR)/$(LIB)
	install -m 644 VkLayer_surreal_boost.json $(DESTDIR)$(LAYERDIR)/VkLayer_surreal_boost.json
	install -m 755 ../scripts/surreal-boost $(DESTDIR)$(BINDIR)/surreal-boost
	test -f $(DESTDIR)/etc/surreal-boost/layer.conf || install -m 644 layer.conf $(DESTDIR)/etc/surreal-boost/layer.conf

uninstall:
	rm -f $(LIBDIR)/$(LIB) $(LAYERDIR)/VkLayer_surreal_boost.json $(BINDIR)/surreal-boost
	rmdir $(LIBDIR) 2>/dev/null || true

clean:
	rm -f $(LIB)

.PHONY: all shaders install uninstall clean
